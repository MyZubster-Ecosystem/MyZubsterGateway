# MyZubsterGateway Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/myzubster

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# HTTPS Configuration
HTTPS_ENABLED=false
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Tor Onion Service Configuration (OPTIONAL - disabled by default)
TOR_ENABLED=false
TOR_SOCKS_HOST=tor
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=tor
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
TOR_HIDDEN_SERVICE_DIR=/var/lib/tor/hidden_service
TOR_HIDDEN_SERVICE_PORT=80
TOR_HIDDEN_SERVICE_TARGET_PORT=3000
TOR_KEY_ROTATION_DAYS=30
TOR_KEY_BACKUP_PATH=/secure/backup/tor-keys

# Multi-instance Failover Configuration
TOR_INSTANCES=
TOR_FAILOVER_ENABLED=true
TOR_HEALTH_CHECK_INTERVAL=30000
TOR_HEALTH_CHECK_TIMEOUT=5000
TOR_MAX_RETRIES=3

# Instance Discovery (comma-separated list of approved onion endpoints)
TOR_APPROVED_INSTANCES=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
