# MyZubster Gateway - Environment Configuration
# Copy to .env and fill in your values

# ── Server ─────────────────────────────────────────────
NODE_ENV=development
GATEWAY_PORT=3000

# ── MongoDB ────────────────────────────────────────────
MONGODB_URI=mongodb://admin:password@mongodb:27017/myzubster?authSource=admin
MONGO_USER=admin
MONGO_PASSWORD=password

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=your-secret-key-change-me-in-production

# ── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Tari Wallet (MYZ) ──────────────────────────────────
TARI_WALLET_PORT=12000
TARI_WALLET_URL=http://tari-wallet:12000

# ── Monero Wallet (XMR) ────────────────────────────────
MONERO_WALLET_PORT=13000
MONERO_WALLET_URL=http://monero-wallet:13000
