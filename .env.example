# MyZubster Gateway Environment Variables
NODE_ENV=production
PORT=10000

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=changeme
MONGODB_URI=mongodb://admin:changeme@mongodb:27017/myzubster?authSource=admin

# Tari Wallet (stub)
TARI_WALLET_RPC=http://tari-wallet:12021
TARI_WALLET_ADDRESS=12Nbmmm5g5pDmJKNTJsHycQoLhYLoAitU4

# Monero Wallet (stub)
XMR_WALLET_RPC=http://monero-wallet:18082
XMR_WALLET_ADDRESS=

# Gateway
GATEWAY_PORT=10000

# Onion discovery (optional profile: onion-discovery)
ONION_DISCOVERY_MAX_STATUS_AGE_MS=120000
ONION_DISCOVERY_PROBE_INTERVAL_MS=30000
ONION_DISCOVERY_PROBE_TIMEOUT_SECONDS=45

# Security
JWT_SECRET=change-me-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Sentry (optional)
SENTRY_DSN=
