# MyZubster Gateway Environment Variables
NODE_ENV=production
PORT=10000

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=changeme
MONGODB_URI=mongodb://admin:changeme@mongodb:27017/myzubster?authSource=admin

# Zorgax controlled data import
# Use a long random secret. Zorgax/backend sends it only server-to-server as x-import-key.
DATA_IMPORT_KEY=replace-with-a-long-random-secret
DATA_IMPORT_MAX_ROWS=2000

# Stripe
# Store real values only in your deployment secret manager. Never commit live/test secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin a Stripe API version. Leave empty to use the account/default API version.
STRIPE_API_VERSION=
# Customer redirect targets after Stripe-hosted Checkout.
STRIPE_SUCCESS_URL=https://myzubster.com/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://myzubster.com/payment/cancel
# Webhook signature timestamp tolerance in seconds.
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Optional internal MyZubster endpoint that receives verified Stripe events.
MYZUBSTER_STRIPE_EVENT_URL=
MYZUBSTER_STRIPE_EVENT_TOKEN=

# Tari Wallet (stub)
TARI_WALLET_RPC=http://tari-wallet:12021
TARI_WALLET_ADDRESS=12Nbmmm5g5pDmJKNTJsHycQoLhYLoAitU4

# Monero Wallet (stub)
XMR_WALLET_RPC=http://monero-wallet:18082
XMR_WALLET_ADDRESS=

# Gateway
GATEWAY_PORT=10000

# Security
JWT_SECRET=change-me-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Sentry (optional)
SENTRY_DSN=
